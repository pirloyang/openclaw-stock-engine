# Deploy 环境变量 — 新机器复制为 .env 后填写
# ──────────────────────────────────────────────

# ═══════ Cron jobs（cron_deploy.py 使用）═══════
# 微信用户 openid（接收消息的人）
WECHAT_USER_ID=o9cq80z60LaB2jyf8JO9xNWsynN4@im.wechat
# 微信 bot 账号 ID（哪个机器人发消息）
WECHAT_BOT_ACCOUNT_ID=75c2b3e86437-im-bot
# 工作区根目录
WORKSPACE_ROOT=/root/.openclaw/workspace

# ═══════ Gateway config（gateway_deploy.py 使用）═══════
# Gateway 认证 token（首次启动 openclaw doctor 时生成）
GATEWAY_AUTH_TOKEN=

# 模型 Provider API Keys
DEEPSEEK_API_KEY=                   # https://platform.deepseek.com
ARKCODE_API_KEY=                    # 火山方舟 ARK
LIGHTCLAWBOT_API_KEY=               # 可选：LightClawBot 通道
TAVILY_API_KEY=                     # https://tavily.com 搜索 API
