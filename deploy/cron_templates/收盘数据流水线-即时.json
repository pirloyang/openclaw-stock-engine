{
  "agentId": "main",
  "name": "收盘数据流水线-即时",
  "enabled": true,
  "schedule": {
    "kind": "cron",
    "expr": "5 15 * * 1-5",
    "tz": "Asia/Shanghai"
  },
  "sessionTarget": "isolated",
  "wakeMode": "now",
  "payload": {
    "kind": "agentTurn",
    "message": "运行收盘即时流水线：bash ${WORKSPACE_ROOT}/scripts/pipeline.sh。完成后输出✅和各文件大小。不做任何分析。",
    "timeoutSeconds": 600,
    "lightContext": true
  },
  "delivery": {
    "mode": "none"
  }
}